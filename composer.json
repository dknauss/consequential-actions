{
	"name": "dknauss/consequential-actions",
	"description": "Reauth MVP: a named registry of consequential actions plus actor-password step-up. A wedge for a WordPress core primitive (Trac #20140).",
	"type": "wordpress-plugin",
	"license": "GPL-2.0-or-later",
	"require": {
		"php": ">=7.4"
	},
	"require-dev": {
		"brain/monkey": "^2.6",
		"phpunit/phpunit": "^9.6",
		"yoast/phpunit-polyfills": "^1.1"
	},
	"autoload-dev": {
		"psr-4": { "ConsequentialActions\\Tests\\": "tests/" }
	},
	"scripts": {
		"test": "phpunit",
		"test:integration": "phpunit -c phpunit-integration.xml.dist"
	},
	"config": {
		"allow-plugins": false,
		"platform": {
			"php": "7.4.0"
		}
	}
}
